---
import BaseLayout from './BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description: string;
  pubDate: Date;
  category: string;
  tags?: string[];
  github?: string;
  demo?: string;
  status?: 'completed' | 'wip' | 'archived';
  thumbnail?: string;
}

const {
  title,
  description,
  pubDate,
  category,
  tags = [],
  github,
  demo,
  status = 'completed',
  thumbnail,
} = Astro.props;

const dateStr = pubDate.toLocaleDateString('ja-JP', {
  year: 'numeric',
  month: 'long',
});

const statusLabel = { completed: '完成', wip: '開発中', archived: 'アーカイブ' }[status];
---

<BaseLayout title={title} description={description} ogImage={thumbnail}>
  <Header />
  <main class="prod-main">
    <div class="prod-hero">
      <div class="container prod-hero-inner">
        <a href="/works" class="back-link">
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
            <path d="M13 8H3M7 4l-4 4 4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
          Works 一覧に戻る
        </a>

        <div class="prod-meta">
          <span class={`badge badge-${status}`}>{statusLabel}</span>
          <span class="tag tag-lavender">{category}</span>
          <time class="prod-date">{dateStr}</time>
        </div>

        <h1 class="prod-title">{title}</h1>
        <p class="prod-description">{description}</p>

        <div class="prod-tags">
          {tags.map(tag => <span class="tag">{tag}</span>)}
        </div>

        <div class="prod-links">
          {github && (
            <a href={github} target="_blank" rel="noopener noreferrer" class="btn btn-primary">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
                <path d="M12 2C6.477 2 2 6.477 2 12c0 4.418 2.865 8.166 6.839 9.489.5.092.682-.217.682-.482 0-.237-.008-.866-.013-1.7-2.782.603-3.369-1.342-3.369-1.342-.454-1.155-1.11-1.462-1.11-1.462-.908-.62.069-.608.069-.608 1.003.07 1.531 1.03 1.531 1.03.892 1.529 2.341 1.087 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.11-4.555-4.943 0-1.091.39-1.984 1.029-2.683-.103-.253-.446-1.27.098-2.647 0 0 .84-.269 2.75 1.025A9.578 9.578 0 0112 6.836c.85.004 1.705.114 2.504.336 1.909-1.294 2.747-1.025 2.747-1.025.546 1.377.203 2.394.1 2.647.64.699 1.028 1.592 1.028 2.683 0 3.842-2.339 4.687-4.566 4.935.359.309.678.919.678 1.852 0 1.336-.012 2.415-.012 2.743 0 .267.18.578.688.48C19.138 20.163 22 16.418 22 12c0-5.523-4.477-10-10-10z"/>
              </svg>
              GitHub
            </a>
          )}
          {demo && (
            <a href={demo} target="_blank" rel="noopener noreferrer" class="btn btn-outline">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M18 13v6a2 2 0 01-2 2H5a2 2 0 01-2-2V8a2 2 0 012-2h6M15 3h6v6M10 14L21 3"/>
              </svg>
              デモを見る
            </a>
          )}
        </div>
      </div>
    </div>

    <div class="container prod-body">
      <article class="prose">
        <slot />
      </article>
      <div class="prod-footer">
        <a href="/works" class="btn btn-outline">
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
            <path d="M13 8H3M7 4l-4 4 4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
          Works 一覧に戻る
        </a>
      </div>
    </div>
  </main>
  <Footer />
</BaseLayout>

<style>
.prod-main { padding-top: var(--header-h); min-height: 100dvh; }

.prod-hero {
  background: var(--bg-secondary);
  border-bottom: 1px solid var(--border);
  padding-block: var(--sp-2xl) var(--sp-3xl);
}

.prod-hero-inner {
  max-width: 780px;
  display: flex;
  flex-direction: column;
  gap: var(--sp-md);
}

.back-link {
  display: inline-flex;
  align-items: center;
  gap: var(--sp-sm);
  font-size: 0.875rem;
  color: var(--text-muted);
  transition: color var(--t-fast);
}
.back-link:hover { color: var(--accent-teal); }

.prod-meta {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: var(--sp-sm);
}

.prod-date { font-size: 0.875rem; color: var(--text-muted); }

.prod-title {
  font-size: clamp(1.6rem, 4vw, 2.5rem);
  font-weight: 800;
  line-height: 1.2;
}

.prod-description {
  font-size: 1.05rem;
  color: var(--text-secondary);
  line-height: 1.8;
}

.prod-tags {
  display: flex;
  flex-wrap: wrap;
  gap: var(--sp-sm);
}

.prod-links {
  display: flex;
  gap: var(--sp-md);
  flex-wrap: wrap;
}

.prod-body {
  padding-block: var(--sp-2xl) var(--sp-3xl);
  max-width: 780px;
}

.prod-footer {
  margin-top: var(--sp-2xl);
  padding-top: var(--sp-xl);
  border-top: 1px solid var(--border);
}
</style>
