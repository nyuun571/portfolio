---
interface Props {
  id: string;
  title: string;
  description: string;
  pubDate: Date;
  category: string;
  tags?: string[];
  github?: string;
  demo?: string;
  status?: "completed" | "wip" | "archived";
  thumbnail?: string;
  featured?: boolean;
}

const {
  id,
  title,
  description,
  pubDate,
  category,
  tags = [],
  github,
  demo,
  status = "completed",
  thumbnail,
  featured = false,
} = Astro.props;

const dateStr = pubDate.toLocaleDateString("ja-JP", {
  year: "numeric",
  month: "short",
});
const statusLabel = {
  completed: "完成",
  wip: "開発中",
  archived: "アーカイブ",
}[status];
const excerpt =
  description.length > 90 ? description.slice(0, 90) + "…" : description;

// Category emoji
const categoryEmoji: Record<string, string> = {
  Webサイト: "🌐",
  Webアプリ: "💻",
  ツール: "🔧",
  ライブラリ: "📦",
  ゲーム: "🎮",
  ボット: "🤖",
};
const emoji = categoryEmoji[category] ?? "✨";
---

<article class={`product-card card${featured ? " is-featured" : ""}`}>
  {
    featured && (
      <div class="pin-badge" aria-label="ピン留め">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          enable-background="new 0 0 24 24"
          height="12"
          viewBox="0 0 24 24"
          width="12"
        >
          <>
            <g>
              <rect fill="none" height="24" width="24" />
            </g>
            <g>
              <path
                d="M16,9V4l1,0c0.55,0,1-0.45,1-1v0c0-0.55-0.45-1-1-1H7C6.45,2,6,2.45,6,3v0 c0,0.55,0.45,1,1,1l1,0v5c0,1.66-1.34,3-3,3h0v2h5.97v7l1,1l1-1v-7H19v-2h0C17.34,12,16,10.66,16,9z"
                fill-rule="evenodd"
              />
            </g>
          </>
        </svg>
      </div>
    )
  }
  <!-- Thumbnail -->
  {
    thumbnail ? (
      <div class="card-thumb">
        <img src={thumbnail} alt={title} loading="lazy" />
      </div>
    ) : (
      <div class="card-thumb card-thumb-plain" aria-hidden="true">
        <span class="thumb-emoji">{emoji}</span>
      </div>
    )
  }

  <div class="card-body">
    <!-- Meta row -->
    <div class="card-meta-row">
      <span class={`badge badge-${status}`}>{statusLabel}</span>
      <span class="tag tag-lavender">{category}</span>
      <time class="card-date">{dateStr}</time>
    </div>

    <!-- Content -->
    <h3 class="card-title">{title}</h3>
    <p class="card-excerpt">{excerpt}</p>

    <!-- Tags -->
    {
      tags.length > 0 && (
        <div class="card-tags">
          {tags.slice(0, 4).map((tag) => (
            <span class="tag">{tag}</span>
          ))}
        </div>
      )
    }

    <!-- Actions -->
    <div class="card-actions">
      <a href={`/works/${id}`} class="btn btn-ghost btn-sm">
        詳細を見る
        <svg
          width="12"
          height="12"
          viewBox="0 0 16 16"
          fill="none"
          aria-hidden="true"
        >
          <path
            d="M3 8h10M9 4l4 4-4 4"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linecap="round"
            stroke-linejoin="round"></path>
        </svg>
      </a>
      <div class="card-links">
        {
          github && (
            <a
              href={github}
              target="_blank"
              rel="noopener noreferrer"
              class="link-icon"
              aria-label="GitHubリポジトリ"
              title="GitHub"
              onclick="event.stopPropagation()"
            >
              <svg
                width="16"
                height="16"
                viewBox="0 0 24 24"
                fill="currentColor"
                aria-hidden="true"
              >
                <path d="M12 2C6.477 2 2 6.477 2 12c0 4.418 2.865 8.166 6.839 9.489.5.092.682-.217.682-.482 0-.237-.008-.866-.013-1.7-2.782.603-3.369-1.342-3.369-1.342-.454-1.155-1.11-1.462-1.11-1.462-.908-.62.069-.608.069-.608 1.003.07 1.531 1.03 1.531 1.03.892 1.529 2.341 1.087 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.11-4.555-4.943 0-1.091.39-1.984 1.029-2.683-.103-.253-.446-1.27.098-2.647 0 0 .84-.269 2.75 1.025A9.578 9.578 0 0112 6.836c.85.004 1.705.114 2.504.336 1.909-1.294 2.747-1.025 2.747-1.025.546 1.377.203 2.394.1 2.647.64.699 1.028 1.592 1.028 2.683 0 3.842-2.339 4.687-4.566 4.935.359.309.678.919.678 1.852 0 1.336-.012 2.415-.012 2.743 0 .267.18.578.688.48C19.138 20.163 22 16.418 22 12c0-5.523-4.477-10-10-10z" />
              </svg>
            </a>
          )
        }
        {
          demo && (
            <a
              href={demo}
              target="_blank"
              rel="noopener noreferrer"
              class="link-icon"
              aria-label="デモサイト"
              title="Demo"
              onclick="event.stopPropagation()"
            >
              <svg
                width="16"
                height="16"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                aria-hidden="true"
              >
                <path d="M18 13v6a2 2 0 01-2 2H5a2 2 0 01-2-2V8a2 2 0 012-2h6M15 3h6v6M10 14L21 3" />
              </svg>
            </a>
          )
        }
      </div>
    </div>
  </div>
</article>

<style>
  .product-card {
    display: flex;
    flex-direction: column;
    position: relative;
  }

  .is-featured {
    border-color: rgba(168, 216, 216, 0.5);
    box-shadow: 0 0 0 1px rgba(168, 216, 216, 0.3);
  }

  .pin-badge {
    position: absolute;
    top: 10px;
    left: 10px;
    z-index: 10;
    display: inline-flex;
    align-items: center;
    gap: 0.3em;
    padding: 0.25em 0.65em;
    background: var(--accent-teal);
    color: #1a2c30;
    font-size: 0.7rem;
    font-weight: 700;
    border-radius: var(--r-full);
    letter-spacing: 0.04em;
    box-shadow: 0 2px 8px rgba(168, 216, 216, 0.4);
  }

  .card-thumb {
    width: 100%;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border-bottom: 1px solid var(--border);
  }

  .card-thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--t-slow);
  }

  .product-card:hover .card-thumb img {
    transform: scale(1.04);
  }

  .card-thumb-plain {
    background: var(--bg-secondary);
    display: flex;
    align-items: center;
    justify-content: center;
    border-bottom: 1px solid var(--border);
  }

  .thumb-emoji {
    font-size: 3rem;
  }

  .card-body {
    display: flex;
    flex-direction: column;
    gap: var(--sp-sm);
    padding: var(--sp-lg);
    flex: 1;
  }

  .card-meta-row {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--sp-sm);
  }

  .card-date {
    font-size: 0.78rem;
    color: var(--text-muted);
    margin-left: auto;
  }

  .card-title {
    font-size: 1.05rem;
    font-weight: 700;
    color: var(--text-primary);
    line-height: 1.4;
    transition: color var(--t-fast);
  }

  .product-card:hover .card-title {
    color: var(--accent-teal);
  }

  .card-excerpt {
    font-size: 0.875rem;
    color: var(--text-muted);
    line-height: 1.7;
    flex: 1;
  }

  .card-tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-xs);
  }

  .card-actions {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-top: var(--sp-sm);
    padding-top: var(--sp-sm);
    border-top: 1px solid var(--border);
  }

  .btn-sm {
    padding: 0.4em 0.9em;
    font-size: 0.82rem;
  }

  .card-links {
    display: flex;
    gap: var(--sp-sm);
  }

  .link-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 30px;
    height: 30px;
    border-radius: var(--r-sm);
    border: 1px solid var(--border);
    color: var(--text-muted);
    transition: all var(--t-fast);
  }

  .link-icon:hover {
    border-color: var(--accent-teal);
    color: var(--accent-teal);
    background: rgba(168, 216, 216, 0.1);
  }
</style>
