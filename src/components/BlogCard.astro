---
interface Props {
  id: string;
  title: string;
  description: string;
  pubDate: Date;
  tags?: string[];
  thumbnail?: string;
  featured?: boolean;
}

const {
  id,
  title,
  description,
  pubDate,
  tags = [],
  thumbnail,
  featured = false,
} = Astro.props;

const dateStr = pubDate.toLocaleDateString("ja-JP", {
  year: "numeric",
  month: "short",
  day: "numeric",
});

const excerpt =
  description.length > 100 ? description.slice(0, 100) + "…" : description;
---

<a
  href={`/blog/${id}`}
  class={`blog-card card${featured ? " is-featured" : ""}`}
  aria-label={title}
>
  {
    featured && (
      <div class="pin-badge" aria-label="ピン留め">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          enable-background="new 0 0 24 24"
          height="12"
          viewBox="0 0 24 24"
          width="12"
        >
          <>
            <g>
              <rect fill="none" height="24" width="24" />
            </g>
            <g>
              <path
                d="M16,9V4l1,0c0.55,0,1-0.45,1-1v0c0-0.55-0.45-1-1-1H7C6.45,2,6,2.45,6,3v0 c0,0.55,0.45,1,1,1l1,0v5c0,1.66-1.34,3-3,3h0v2h5.97v7l1,1l1-1v-7H19v-2h0C17.34,12,16,10.66,16,9z"
                fill-rule="evenodd"
              />
            </g>
          </>
        </svg>
      </div>
    )
  }
  {
    thumbnail ? (
      <div class="card-thumb">
        <img src={thumbnail} alt={title} loading="lazy" />
      </div>
    ) : (
      <div class="card-thumb card-thumb-plain" aria-hidden="true">
        <div class="thumb-decoration">✍️</div>
      </div>
    )
  }

  <div class="card-body">
    <div class="card-tags">
      {tags.slice(0, 3).map((tag) => <span class="tag">{tag}</span>)}
    </div>
    <h3 class="card-title">{title}</h3>
    <p class="card-excerpt">{excerpt}</p>
    <div class="card-meta">
      <time datetime={pubDate.toISOString()} class="card-date">{dateStr}</time>
      <span class="card-read">
        続きを読む
        <svg
          width="12"
          height="12"
          viewBox="0 0 16 16"
          fill="none"
          aria-hidden="true"
        >
          <path
            d="M3 8h10M9 4l4 4-4 4"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linecap="round"
            stroke-linejoin="round"></path>
        </svg>
      </span>
    </div>
  </div>
</a>

<style>
  .blog-card {
    display: flex;
    flex-direction: column;
    text-decoration: none;
    cursor: pointer;
    position: relative;
    height: 100%;
  }

  .is-featured {
    border-color: rgba(168, 216, 216, 0.5);
    box-shadow: 0 0 0 1px rgba(168, 216, 216, 0.3);
  }

  .pin-badge {
    position: absolute;
    top: 10px;
    left: 10px;
    z-index: 10;
    display: inline-flex;
    align-items: center;
    gap: 0.3em;
    padding: 0.25em 0.65em;
    background: var(--accent-teal);
    color: #1a2c30;
    font-size: 0.7rem;
    font-weight: 700;
    border-radius: var(--r-full);
    letter-spacing: 0.04em;
    box-shadow: 0 2px 8px rgba(168, 216, 216, 0.4);
  }

  .card-thumb {
    width: 100%;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border-bottom: 1px solid var(--border);
    flex-shrink: 0;
  }

  .card-thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--t-slow);
  }

  .blog-card:hover .card-thumb img {
    transform: scale(1.04);
  }

  .card-thumb-plain {
    background: var(--bg-secondary);
    display: flex;
    align-items: center;
    justify-content: center;
    border-bottom: 1px solid var(--border);
  }

  .thumb-decoration {
    font-size: 2.5rem;
    opacity: 0.7;
  }

  .card-body {
    display: flex;
    flex-direction: column;
    gap: var(--sp-sm);
    padding: var(--sp-lg);
    flex: 1;
  }

  .card-tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-xs);
  }

  .card-title {
    font-size: 1.05rem;
    font-weight: 700;
    color: var(--text-primary);
    line-height: 1.4;
    transition: color var(--t-fast);
  }

  .blog-card:hover .card-title {
    color: var(--accent-teal);
  }

  .card-excerpt {
    font-size: 0.875rem;
    color: var(--text-muted);
    line-height: 1.7;
    flex: 1;
  }

  .card-meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-top: var(--sp-sm);
  }

  .card-date {
    font-size: 0.78rem;
    color: var(--text-muted);
  }

  .card-read {
    display: inline-flex;
    align-items: center;
    gap: 0.3em;
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--accent-teal);
    opacity: 0;
    transition:
      opacity var(--t-fast),
      transform var(--t-fast);
    transform: translateX(-4px);
  }

  .blog-card:hover .card-read {
    opacity: 1;
    transform: translateX(0);
  }
</style>
