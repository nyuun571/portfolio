---
import { siteConfig } from '../config/site';

const iconPaths: Record<string, string> = {
  github: `<path d="M12 2C6.477 2 2 6.477 2 12c0 4.418 2.865 8.166 6.839 9.489.5.092.682-.217.682-.482 0-.237-.008-.866-.013-1.7-2.782.603-3.369-1.342-3.369-1.342-.454-1.155-1.11-1.462-1.11-1.462-.908-.62.069-.608.069-.608 1.003.07 1.531 1.03 1.531 1.03.892 1.529 2.341 1.087 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.11-4.555-4.943 0-1.091.39-1.984 1.029-2.683-.103-.253-.446-1.27.098-2.647 0 0 .84-.269 2.75 1.025A9.578 9.578 0 0112 6.836c.85.004 1.705.114 2.504.336 1.909-1.294 2.747-1.025 2.747-1.025.546 1.377.203 2.394.1 2.647.64.699 1.028 1.592 1.028 2.683 0 3.842-2.339 4.687-4.566 4.935.359.309.678.919.678 1.852 0 1.336-.012 2.415-.012 2.743 0 .267.18.578.688.48C19.138 20.163 22 16.418 22 12c0-5.523-4.477-10-10-10z"/>`,
  twitter: `<path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>`,
  email: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>`,
};
---

<section class="hero" id="hero">
  <div class="container hero-inner">

    <!-- 左: アイコン -->
    <div class="hero-avatar-wrap anim-fade-up" style="animation-delay:0.05s">
      <img
        src={siteConfig.avatar}
        alt={siteConfig.name}
        class="hero-avatar"
        loading="eager"
      />
    </div>

    <!-- 右: 名前 + 自己紹介 -->
    <div class="hero-content">
      <h1 class="hero-name anim-fade-up" style="animation-delay:0.1s">
        {siteConfig.name}
      </h1>
      <p class="hero-tagline anim-fade-up" style="animation-delay:0.15s">
        {siteConfig.tagline}
      </p>
      <p class="hero-bio anim-fade-up" style="animation-delay:0.2s">
        {siteConfig.bio}
      </p>

      <div class="hero-social anim-fade-up" style="animation-delay:0.25s">
        {siteConfig.social.map(link => (
          <a
            href={link.href}
            target={link.href.startsWith('mailto:') ? '_self' : '_blank'}
            rel="noopener noreferrer"
            class="social-link"
            aria-label={link.label}
            title={link.label}
          >
            <svg
              width="20"
              height="20"
              viewBox="0 0 24 24"
              fill={link.icon === 'email' ? 'none' : 'currentColor'}
              stroke={link.icon === 'email' ? 'currentColor' : 'none'}
              aria-hidden="true"
            >
              <Fragment set:html={iconPaths[link.icon] ?? iconPaths.email} />
            </svg>
          </a>
        ))}
      </div>
    </div>

  </div>
</section>

<style>
.hero {
  padding-top: calc(var(--header-h) + var(--sp-2xl));
  padding-bottom: var(--sp-3xl);
  border-bottom: 1px solid var(--border);
}

.hero-inner {
  display: flex;
  align-items: center;
  gap: var(--sp-2xl);
}

@media (max-width: 640px) {
  .hero-inner {
    flex-direction: column;
    text-align: center;
    gap: var(--sp-lg);
  }
}

/* Avatar */
.hero-avatar-wrap { flex-shrink: 0; }

.hero-avatar {
  width: 140px;
  height: 140px;
  border-radius: 50%;
  object-fit: cover;
  border: 2px solid var(--border);
  display: block;
}

@media (max-width: 640px) {
  .hero-avatar { width: 100px; height: 100px; }
}

/* Content */
.hero-content { flex: 1; }

.hero-name {
  font-size: clamp(1.8rem, 4vw, 2.8rem);
  font-weight: 800;
  letter-spacing: -0.03em;
  line-height: 1.15;
  margin-bottom: var(--sp-xs);
  color: var(--text-primary);
}

.hero-tagline {
  font-size: 0.95rem;
  font-weight: 500;
  color: var(--text-muted);
  margin-bottom: var(--sp-md);
}

.hero-bio {
  font-size: 0.975rem;
  color: var(--text-secondary);
  line-height: 1.8;
  margin-bottom: var(--sp-lg);
  max-width: 460px;
  white-space: pre-wrap;
}

@media (max-width: 640px) { .hero-bio { max-width: none; } }

.hero-social {
  display: flex;
  gap: var(--sp-md);
  align-items: center;
}

@media (max-width: 640px) { .hero-social { justify-content: center; } }

.social-link {
  color: var(--text-muted);
  transition: color var(--t-fast), transform var(--t-fast);
}
.social-link:hover { color: var(--text-primary); transform: translateY(-2px); }
</style>
